# Get a key at https://console.anthropic.com/settings/keys
# The app runs without this — capture and manual editing work,
# only AI drafting is disabled.
ANTHROPIC_API_KEY=

# Set to `claude-code` to analyze via the Claude Code CLI instead of the API,
# billing analysis to your Claude subscription rather than API credits.
# Requires `claude` on PATH and an active `claude` login. Leave unset to use
# the Anthropic API with the key above.
ANALYZER=
